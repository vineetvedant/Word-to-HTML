      "id": "word-to-html",
      "name": "Word to Clean HTML Converter",
      "description": "Transforms rich text from Microsoft Word, Google Docs, and RTF into clean HTML 1.0 or modern semantic HTML, purging MSO tags and inline CSS.",
      "type": "client-tool",
      "target": "https://wordtohtml1.0.sshconnect.space/",
      "input": {
        "format": "text/html, text/plain",
        "description": "Pasted rich formatted text or HTML markup"
