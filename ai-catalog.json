      "output": {
        "format": "text/html",
        "description": "Clean, sanitized HTML 1.0 markup or fragment"
      }
    },
    {
      "id": "html-to-word",
      "name": "HTML to Word Document (.doc) Converter",
      "description": "Converts raw HTML strings and formatted markup into editable Microsoft Word (.doc) files.",
