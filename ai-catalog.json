      "target": "https://wordtohtml1.0.sshconnect.space/html-to-word/",
      "input": {
        "format": "text/html",
        "description": "Raw HTML source code"
      },
      "output": {
        "format": "application/msword",
        "description": "Standard .doc binary document"
      }
    }
